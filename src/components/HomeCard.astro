---
import Wrapper from "./Wrapper.astro";
import RandomImage from "./RandomImage.jsx"; // será un island React/vanilla

interface Props {
  images: Array<{
    src: string;
    srcSet?: string;
    sizes?: string;
    width?: number;
    height?: number;
  }>;
}

const { images } = Astro.props;
---

<Wrapper>
  <RandomImage client:load images={images} />
</Wrapper>
