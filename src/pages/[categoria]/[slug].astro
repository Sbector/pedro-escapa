---
import Layout from "@layouts/Layout.astro";
import { menu } from "@lib/menu";
import { getSubitemData } from "@lib/getSubitemData";
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import Carousel from "@components/Carousel.jsx";
import Wrapper from "@components/Wrapper.astro";

export async function getStaticPaths() {
  const paths = [];

  for (const item of menu) {
    if (item.visible !== false && item.subitems) {
      for (const sub of item.subitems) {
        if (sub.visible !== false) {
          paths.push({
            params: {
              categoria: item.id,
              slug: sub.slug,
            },
          });
        }
      }
    }
  }

  return paths;
}

const { categoria, slug } = Astro.params;
const subitemData = getSubitemData(menu, categoria, slug);

if (!subitemData) {
  return Astro.redirect("/404");
}

// Construir la ruta actual explícitamente
const currentPath = `/${categoria}/${slug}`;

// Traer la colección de imágenes
const itemCollections = await getCollection("itemCollections");
const collection = itemCollections.find((item) => item.id === slug);

// Traer la colección de descripciones
const descriptions = await getCollection("descriptions");

let DescriptionContent = null;
if (collection?.data?.description) {
  const descriptionRef = collection.data.description;

  const refId =
    typeof descriptionRef === "string" ? descriptionRef : descriptionRef.id;
  const descriptionEntry = descriptions.find((desc) => desc.id === refId);

  if (descriptionEntry) {
    const { Content } = await render(descriptionEntry);
    DescriptionContent = Content;
  }
}

const pageTitle = `${collection?.data.title ?? subitemData.label} · Pedro Escapa`;
const firstImage = collection?.data?.images?.[0];
const pageDescription = firstImage
  ? `${firstImage.title ?? ""} ${firstImage.description ?? ""}`.trim().slice(0, 155) || `${collection?.data.title ?? subitemData.label} – obra de Pedro Escapa`
  : `${collection?.data.title ?? subitemData.label} – obra de Pedro Escapa`;
const ogImage = firstImage?.imageRoute?.src;

const responsiveImages = collection?.data?.images
  ? await Promise.all(
      collection.data.images.map(async (img: any) => {
        const optimized = await getImage({
          src: img.imageRoute,
          format: "webp",
          quality: 85,
          widths: [640, 1024],
          sizes: "(max-width: 768px) 100vw, 80vw",
        });
        return {
          title: img.title,
          description: img.description,
          src: optimized.src,
          srcSet: (optimized as any).srcSet?.attribute ?? undefined,
          sizes: "(max-width: 768px) 100vw, 80vw",
          width: optimized.attributes.width,
          height: optimized.attributes.height,
        };
      })
    )
  : [];

const carouselItems = [
  ...responsiveImages,
  ...(collection?.data?.video ? [collection.data.video] : []),
];

const preloadFirst = responsiveImages[0];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  currentPath={currentPath}
  preloadImage={preloadFirst ? { href: preloadFirst.src, imagesrcset: preloadFirst.srcSet, imagesizes: preloadFirst.sizes } : undefined}
>
  <div class="h-full w-full overflow-y-auto snap-y snap-mandatory">
    <Wrapper id="carousel-section" className="min-h-full snap-start">
  {
    (collection?.data?.images || collection?.data?.video) && (
      <Carousel 
        client:idle 
        items={carouselItems} 
        mode={collection.data.carouselMode}
      />
    )
  }
</Wrapper>

    {DescriptionContent && (
      <div
        id="info-button"
        class="sticky bottom-0 lg:bottom-6 right-0 z-10 flex justify-end pointer-events-none transition-opacity duration-300"
      >
        <button
          id="scroll-to-text"
          type="button"
          aria-label="Ver información"
          class="pointer-events-auto inline-flex items-center gap-2
                px-3 py-1.5
                text-sm
                bg-white/80 backdrop-blur-sm
                hover:-translate-y-0.5 hover:shadow-lg
                transition"
        >
          [ + información ]
        </button>
      </div>
    )}

    {DescriptionContent && (
      <div
        id="text-section"
        class="prose prose-sm 
        prose-headings:text-2xl prose-headings:pt-8
        prose-strong:text-2xl
        max-w-none min-h-full
        pt-8 lg:pt-40 
        pb-16 lg:pb-48 
        px-6 lg:px-20
        text-justify
        snap-start"  
      >
        <DescriptionContent pb-16/>
      </div>
    )}
  </div>

  <script>
    function setupInfoButton() {
      const button = document.getElementById("scroll-to-text");
      const hint = document.getElementById("info-button");
      const target = document.getElementById("text-section");

      if (!button || !target) return;

      button.onclick = () => {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      };

      if (hint && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              hint.classList.toggle("opacity-0", entry.isIntersecting);
              button.classList.toggle("pointer-events-auto", !entry.isIntersecting);
            });
          },
          { threshold: 0.3 }
        );
        observer.observe(target);
      }
    }

    setupInfoButton();

    document.addEventListener("astro:page-load", setupInfoButton);
  </script>
</Layout>

